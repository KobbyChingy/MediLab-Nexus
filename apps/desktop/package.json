{
  "name": "@medilab/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "OmniWeave Softwares",
  "description": "Standalone desktop application for MediLab Nexus diagnostic workflows.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts --format esm --platform node --external electron",
    "typecheck": "tsc --noEmit",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.omniweave.medilabnexus",
    "productName": "MediLab Nexus",
    "directories": {
      "output": "../../dist-desktop"
    },
    "files": [
      "dist/**/*",
      "desktop.config.json",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "35.5.1",
    "electron-builder": "^25.1.8",
    "tsup": "^8.4.0"
  }
}