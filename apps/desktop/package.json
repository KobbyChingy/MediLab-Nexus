{
  "name": "@medilab/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "OmniWeave Softwares",
  "description": "Standalone desktop application for MediLab Nexus diagnostic workflows.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts --format esm --platform node --external electron",
    "typecheck": "tsc --noEmit",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.omniweave.medilabnexus",
    "productName": "MediLab Nexus",
    "directories": {
      "output": "../../dist-desktop"
    },
    "files": [
      "dist/**/*",
      "desktop.config.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../apps/api/dist",
        "to": "runtime/apps/api/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../apps/web/dist",
        "to": "runtime/apps/web/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../packages",
        "to": "runtime/packages",
        "filter": [
          "db/package.json",
          "db/dist/**/*",
          "db/prisma/schema.prisma",
          "shared/package.json",
          "shared/dist/**/*"
        ]
      },
      {
        "from": "../../node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "@fastify/**/*",
          "@prisma/**/*",
          "@standard-schema/**/*",
          "@types/**/*",
          ".prisma/**/*",
          "abstract-logging/**/*",
          "ajv-formats/**/*",
          "avvio/**/*",
          "atomic-sleep/**/*",
          "base64-js/**/*",
          "brotli-size/**/*",
          "clone/**/*",
          "c12/**/*",
          "chokidar/**/*",
          "citty/**/*",
          "confbox/**/*",
          "consola/**/*",
          "cookie/**/*",
          "debug/**/*",
          "deepmerge-ts/**/*",
          "defu/**/*",
          "dequal/**/*",
          "dfa/**/*",
          "dotenv/**/*",
          "effect/**/*",
          "empathic/**/*",
          "end-of-stream/**/*",
          "events/**/*",
          "exsolve/**/*",
          "fast-content-type-parse/**/*",
          "fast-decode-uri-component/**/*",
          "fast-deep-equal/**/*",
          "fast-check/**/*",
          "fast-json-stringify/**/*",
          "fast-querystring/**/*",
          "fast-redact/**/*",
          "fast-uri/**/*",
          "fastify/**/*",
          "find-my-way/**/*",
          "fontkit/**/*",
          "giget/**/*",
          "ieee754/**/*",
          "ipaddr.js/**/*",
          "jiti/**/*",
          "joycon/**/*",
          "light-my-request/**/*",
          "linebreak/**/*",
          "ms/**/*",
          "node-fetch-native/**/*",
          "on-exit-leak-free/**/*",
          "ohash/**/*",
          "once/**/*",
          "pako/**/*",
          "pathe/**/*",
          "pdfkit/**/*",
          "perfect-debounce/**/*",
          "picomatch/**/*",
          "pino/**/*",
          "pino-abstract-transport/**/*",
          "pino-std-serializers/**/*",
          "process-warning/**/*",
          "prisma/**/*",
          "pkg-types/**/*",
          "pure-rand/**/*",
          "quick-format-unescaped/**/*",
          "react/**/*",
          "react-dom/**/*",
          "rc9/**/*",
          "real-require/**/*",
          "require-from-string/**/*",
          "ret/**/*",
          "reusify/**/*",
          "rfdc/**/*",
          "safe-regex2/**/*",
          "safe-stable-stringify/**/*",
          "scheduler/**/*",
          "secure-json-parse/**/*",
          "semver/**/*",
          "set-cookie-parser/**/*",
          "sonic-boom/**/*",
          "split2/**/*",
          "streamx/**/*",
          "strnum/**/*",
          "text-decoder/**/*",
          "thread-stream/**/*",
          "tiny-inflate/**/*",
          "unicode-properties/**/*",
          "unicode-trie/**/*",
          "wrappy/**/*",
          "zod/**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "35.5.1",
    "electron-builder": "^25.1.8",
    "tsup": "^8.4.0"
  }
}